# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/

# Tool caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Jupyter
.ipynb_checkpoints/

# Secrets (API keys); keep the example file
.env
.env.*
!.env.example

# OS and editor
.DS_Store
.vscode/
.idea/

# Reference databases (multi-GB, re-downloadable)
databases/
*.hmm
*.h3[fimp]
*.dmnd

# Generated pipeline outputs (all recreated by running main.py)
results/
!Phase-0/results/

# Regenerable pipeline outputs: annotation_, bakta_, go_, homology_, pfam_ and
# pyrodigal_results. The frozen copies the Phase 0 scorer needs live in
# Phase-0/pipeline/source/ and Phase-0/bakta/; the rest are reproduced by
# phase0-bundle/scripts/run_pipeline.py.
Structural_annotation/*_results/
Structural_annotation/pfam_hits*.tsv

# Phase 0: sanity-check outputs are regenerated by sanity_checks.py; keep only the log and deleted-gene list
Phase-0/sanity/*
!Phase-0/sanity/sanity_checks.log
!Phase-0/sanity/deleted_genes.tsv
